// On-Device Local AI Enhancement Studio Contract
// DnCNN Denoising, MiDaS Depth Bokeh, MobileNet Scene Detection, Real-ESRGAN 4x Upscaling, Zero-DCE Low Light

component AiLabView {
    state {
        detected_scene: string = "Portrait"
        scene_confidence: float = 0.94
        denoise_strength: float = 0.5 // 0.0 to 1.0
        lowlight_strength: float = 0.6 // 0.0 to 1.0
        bokeh_aperture: float = 2.8 // f/1.4 to f/16.0
        bokeh_blur_radius: float = 12.0 // 1.0 to 30.0 px
        super_res_active: bool = false
        ai_execution_provider: string = "NNAPI (Qualcomm NPU)"
    }

    style {
        padding: 12px
        display: "flex"
        flex_direction: "column"
        gap: 10px
    }

    // Scene Auto-Detection Header Card (MobileNetV3)
    view SceneDetectionCard {
        style {
            background-color: "#1E293B"
            border_radius: 8px
            padding: "8px 12px"
            display: "flex"
            flex_direction: "row"
            justify_content: "space-between"
            align_items: "center"
            border-left: "4px solid #38BDF8"
        }

        view SceneInfo {
            style { display: "flex"; flex_direction: "column" }
            text SceneLabel { value: "AI SCENE DETECTION"; style { font_size: 9px; font_weight: "bold"; color: "#94A3B8"; letter-spacing: "0.5px" } }
            text SceneValue { value: format("{:s} ({:.0f}% confidence)", state.detected_scene, state.scene_confidence * 100); style { font_size: 13px; font_weight: "600"; color: "#F8FAFC" } }
        }

        button AutoEnhanceBtn {
            text: "Auto Tone"
            on_click: emit("apply_scene_auto_enhance", { scene: state.detected_scene })
            style {
                background_color: "#38BDF8"; color: "#0F172A"; font_size: 11px; font_weight: "bold"
                border_radius: 6px; padding: "5px 12px"
            }
        }
    }

    // 4 Modular AI Processors
    view AiControlsGrid {
        style { display: "flex"; flex_direction: "column"; gap: 8px }

        // 1. DnCNN Denoising
        view DenoiseCard {
            style { background-color: "#15181E"; border-radius: 6px; padding: "8px 10px"; display: "flex"; flex_direction: "row"; align_items: "center"; justify_content: "space-between" }
            view LeftLabel {
                style { width: 110px }
                text Title { value: "DnCNN Denoise"; style { font_size: 12px; font_weight: "600"; color: "#E2E8F0" } }
                text Sub { value: "Sensor Grain"; style { font_size: 9px; color: "#94A3B8" } }
            }
            slider S { min: 0.0; max: 1.0; step: 0.05; value: state.denoise_strength; on_change: state.denoise_strength = event.value; style { flex: 1; margin_horizontal: 10px } }
            button ApplyDenoiseBtn {
                text: "Apply"
                on_click: emit("apply_ai_pass", { type: 1, strength: state.denoise_strength })
                style { background_color: "#2563EB"; color: "#FFFFFF"; font_size: 11px; border_radius: 5px; padding: "4px 10px" }
            }
        }

        // 2. Zero-DCE Low Light Booster
        view LowLightCard {
            style { background-color: "#15181E"; border-radius: 6px; padding: "8px 10px"; display: "flex"; flex_direction: "row"; align_items: "center"; justify_content: "space-between" }
            view LeftLabel {
                style { width: 110px }
                text Title { value: "Zero-DCE Night"; style { font_size: 12px; font_weight: "600"; color: "#E2E8F0" } }
                text Sub { value: "Shadow Recovery"; style { font_size: 9px; color: "#94A3B8" } }
            }
            slider S { min: 0.0; max: 1.0; step: 0.05; value: state.lowlight_strength; on_change: state.lowlight_strength = event.value; style { flex: 1; margin_horizontal: 10px } }
            button ApplyLowLightBtn {
                text: "Apply"
                on_click: emit("apply_ai_pass", { type: 2, strength: state.lowlight_strength })
                style { background_color: "#2563EB"; color: "#FFFFFF"; font_size: 11px; border_radius: 5px; padding: "4px 10px" }
            }
        }

        // 3. MiDaS Synthetic Depth Bokeh
        view DepthBokehCard {
            style { background-color: "#15181E"; border-radius: 6px; padding: "8px 10px"; display: "flex"; flex_direction: "row"; align_items: "center"; justify_content: "space-between" }
            view LeftLabel {
                style { width: 110px }
                text Title { value: "MiDaS Bokeh"; style { font_size: 12px; font_weight: "600"; color: "#E2E8F0" } }
                text Sub { value: format("f/{:.1f} Aperture", state.bokeh_aperture); style { font_size: 9px; color: "#38BDF8" } }
            }
            slider S { min: 1.4; max: 16.0; step: 0.2; value: state.bokeh_aperture; on_change: state.bokeh_aperture = event.value; style { flex: 1; margin_horizontal: 10px } }
            button ApplyBokehBtn {
                text: "Blur"
                on_click: emit("apply_ai_pass", { type: 4, strength: 1.0 / state.bokeh_aperture })
                style { background_color: "#2563EB"; color: "#FFFFFF"; font_size: 11px; border_radius: 5px; padding: "4px 10px" }
            }
        }

        // 4. Real-ESRGAN 4x Super Resolution
        view SuperResCard {
            style { background-color: "#15181E"; border-radius: 6px; padding: "8px 10px"; display: "flex"; flex_direction: "row"; align_items: "center"; justify_content: "space-between" }
            view LeftLabel {
                style { width: 110px }
                text Title { value: "Real-ESRGAN"; style { font_size: 12px; font_weight: "600"; color: "#E2E8F0" } }
                text Sub { value: "4x Super-Res (48MP)"; style { font_size: 9px; color: "#10B981" } }
            }
            text Info { value: "Reconstruct fine details & hair"; style { font_size: 10px; color: "#94A3B8"; flex: 1; margin_horizontal: 10px } }
            button UpscaleBtn {
                text: "4x Upscale"
                on_click: emit("apply_ai_pass", { type: 3, strength: 1.0 })
                style { background_color: "#10B981"; color: "#FFFFFF"; font_size: 11px; font_weight: "bold"; border_radius: 5px; padding: "4px 10px" }
            }
        }
    }
}
